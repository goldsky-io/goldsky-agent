{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/pre-deploy-validate.sh\" cursor",
        "matcher": "goldsky\\s+turbo\\s+apply"
      },
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/secret-check.sh\" cursor",
        "matcher": "goldsky\\s+turbo\\s+apply"
      }
    ],
    "afterShellExecution": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/post-deploy-inspect.sh\" cursor",
        "matcher": "goldsky\\s+turbo\\s+apply"
      }
    ]
  }
}
